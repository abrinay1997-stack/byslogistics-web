---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';

/**
 * TODO(catálogo): por ahora solo está cargada la categoría "Precintos de
 * Botella", la única visible en el material recibido. Faltan las demás
 * categorías del menú desplegable "Precintos" del sitio actual. Agregar una
 * categoría es crear un archivo en src/content/precintos/.
 */
const precintos = (await getCollection('precintos')).sort(
  (a, b) => a.data.order - b.data.order
);

const pageTitle = `Precintos | ${SITE.title}`;
const metaDescription =
  'Categorías de precintos de seguridad de B&S Logistics: elementos que evidencian cualquier intento de manipulación y garantizan la cadena de custodia.';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/precintos`,
    url: `${SITE.url}/precintos`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'es-CO',
  }}
>
  <MainSection
    title="Precintos de Seguridad"
    subTitle="Manejamos distintas categorías según el punto que se necesite asegurar. Cada precinto va numerado y no puede retirarse sin dejar evidencia."
  />

  <section class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        precintos.map(categoria => (
          <a
            href={`/precintos/${categoria.id}`}
            class="group hover:border-brand-400 dark:hover:border-brand-400 flex flex-col rounded-xl border border-neutral-300 bg-neutral-100 p-6 ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 dark:border-neutral-700 dark:bg-neutral-900 dark:ring-zinc-200"
          >
            <h2 class="font-bold text-neutral-800 dark:text-neutral-200">
              {categoria.data.title}
            </h2>
            <p class="mt-2 grow text-sm text-neutral-600 dark:text-neutral-400">
              {categoria.data.description}
            </p>
            {categoria.data.products.length > 0 && (
              <p class="mt-3 text-xs text-neutral-500">
                {categoria.data.products.length}
                {categoria.data.products.length === 1
                  ? ' referencia'
                  : ' referencias'}
              </p>
            )}
            <span class="text-brand-600 dark:text-brand-400 mt-4 inline-flex items-center gap-x-2 text-sm font-medium">
              Ver categoría
              <Icon name="arrowRight" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <HeroSectionAlt
    title="¿Necesita una referencia específica?"
    subTitle="Descríbanos el punto que necesita asegurar y le indicamos la referencia adecuada para su operación."
    url="/contacto"
    btnTitle="Solicitar asesoría"
  />
</MainLayout>
