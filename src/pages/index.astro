---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import SolutionsCarousel from '@components/ui/blocks/SolutionsCarousel.astro';
import heroImage from '@images/backgrounds/precinto-tecnologia.jpg';
import testimonialsBackdrop from '@images/backgrounds/precintos-estudio.jpg';
import { partnersData } from '@/data_files/constants';

/**
 * Home. Es una página de entrada: resume la propuesta y enlaza a cada sección,
 * que vive en su propia página (/precintos, /productos, /usos, /nosotros,
 * /faq, /contacto).
 *
 * Las fotos de producto salen del listado de precios (ver
 * scripts/extract-xlsx-images.mjs); los fondos de sección, de las imágenes
 * de marca en src/images/backgrounds/.
 */
const soluciones = (await getCollection('soluciones')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<MainLayout heroASangre={true}>
  <HeroSection
    title=`<span class="text-brand-200">B&S</span>, Líderes en Seguridad Preventiva`
    subTitle="En B&S LOGISTICS nos especializamos en la distribución y comercialización de elementos de Seguridad preventiva. Estamos comprometidos en ofrecer productos de óptima calidad que permitan garantizar la trazabilidad y custodia de bienes y activos."
    primaryBtn="Ver Productos"
    primaryBtnURL="/productos"
    secondaryBtn="Contáctenos"
    secondaryBtnURL="/contacto"
    src={heroImage}
    nextSection="soluciones"
  />

  {
    partnersData.length > 0 && (
      <ClientsSection
        title="Empresas que confían en nosotros"
        subTitle="Suministramos a líderes de industria en múltiples sectores."
        partners={partnersData}
      />
    )
  }

  {
    /* Resumen de soluciones: cada tarjeta lleva a su propia página.
      El `id` es el destino de la señal de "sigue hacia abajo" del hero. */
  }
  <section
    id="soluciones"
    class="mx-auto max-w-[85rem] px-10 py-16 sm:px-14 lg:px-20 lg:py-24"
  >
    <div class="max-w-2xl">
      <h2
        class="text-3xl font-bold text-balance text-neutral-800 lg:text-5xl dark:text-neutral-100"
      >
        Nuestras Soluciones
      </h2>
      <p
        class="mt-4 max-w-prose text-lg leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400"
      >
        A continuación encontrará los productos en los que nos especializamos.
        Contamos con una completa gama a precios competitivos enfocados a
        brindar soluciones logísticas en transporte y control de activos.
      </p>
    </div>

    {
      /*
        Carrusel y no la misma rejilla de /productos: quien baja por la portada
        ya vio esas seis tarjetas si entró al listado, y repetirlas no le dice
        nada nuevo. Aquí se recorren de lado, con la foto grande.
      */
    }
    <div class="mt-6">
      <SolutionsCarousel
        soluciones={soluciones.map(solucion => ({
          id: solucion.id,
          title: solucion.data.title,
          description: solucion.data.description,
          image: solucion.data.cardImage,
          imageAlt: solucion.data.cardImageAlt,
          highlights: solucion.data.highlights,
        }))}
      />
    </div>
  </section>

  <TestimonialsSection
    title="Testimonios de Nuestros Clientes"
    subTitle="Estas son algunas opiniones de nuestros clientes, contamos con 5 estrellas en la puntuación de satisfacción de Google."
    testimonials={[
      {
        content:
          'Su asesoría al momento de elegir el producto que mejor se adaptara a las necesidades de mi empresa, fue clave para el éxito de los procesos logísticos de mi negocio. Los recomiendo.',
        author: 'Daniel Molina',
        role: 'Reseña de Google · 5 estrellas',
      },
    ]}
    backdrop={testimonialsBackdrop}
  />

  <HeroSectionAlt
    title="Estamos Aquí Para Ayudarle, Contáctenos Ahora"
    subTitle="Tenemos una gran variedad de elementos de seguridad. Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa."
    url="/contacto"
  />
</MainLayout>
