---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import heroImage from '@images/hero-image.avif';
import faqs from '@data/faqs.json';
import features from '@data/features.json';
import featureImage from '@images/features-image.avif';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { partnersData, SITE } from '@/data_files/constants';
---

<MainLayout>
  <HeroSection
    title=`Soluciones logísticas con <span
        class="text-yellow-500 dark:text-yellow-400">BYS Logistics</span>`
    subTitle="Diseñamos operaciones logísticas a la medida para posicionar tus productos de forma competitiva en el mercado colombiano."
    primaryBtn="Ver servicios"
    primaryBtnURL="/services"
    secondaryBtn="Solicitar cotización"
    secondaryBtnURL="/contact"
    src={heroImage}
    alt="Operación de carga y distribución de mercancía"
  />

  {
    partnersData.length > 0 && (
      <ClientsSection
        title="Empresas que confían en nosotros"
        subTitle="Acompañamos la cadena de suministro de compañías en distintos sectores."
        partners={partnersData}
      />
    )
  }

  <FeaturesGeneral
    title="Logística pensada para tu operación"
    subTitle={SITE.description}
    src={featureImage}
    alt="Mercancía preparada para su distribución"
    features={features}
  />

  <FeaturesNavs
    title=`Conoce cómo <span class="text-yellow-500 dark:text-yellow-400">BYS Logistics</span> se adapta a las necesidades de tu cadena de suministro.`
    tabs={[
      {
        heading: 'Transporte y distribución',
        content:
          'Movilizamos mercancía de todos los tamaños con el equipo adecuado para cada tipo de carga, incluido el traslado de mobiliario.',
        svg: 'tools',
        src: tools,
        alt: 'Vehículo de carga durante una operación de transporte',
        first: true,
      },
      {
        heading: 'Comercio exterior',
        content:
          'Acompañamos tus operaciones de importación y exportación con estrategias propias que reducen tiempos y simplifican la gestión documental.',
        svg: 'dashboard',
        src: dashboard,
        alt: 'Seguimiento de una operación de comercio exterior',
        second: true,
      },
      {
        heading: 'Almacenamiento y manejo de carga',
        content:
          'Gestionamos el manejo de tu mercancía con procesos definidos en cada etapa, para que sepas siempre en qué estado se encuentra.',
        svg: 'house',
        src: construction,
        alt: 'Bodega con mercancía organizada para su distribución',
      },
    ]}
  />

  <FAQ title="Preguntas<br />frecuentes" faqs={faqs} />
</MainLayout>
