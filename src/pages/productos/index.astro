---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';

const soluciones = (await getCollection('soluciones')).sort(
  (a, b) => a.data.order - b.data.order
);

const pageTitle = `Productos | ${SITE.title}`;
const metaDescription =
  'Precintos de seguridad, etiquetas y cintas, tulas y bolsas, y cajas de seguridad. Conozca la gama de elementos de seguridad preventiva de B&S Logistics.';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/productos`,
    url: `${SITE.url}/productos`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'es-CO',
  }}
>
  <MainSection
    title="Nuestras Soluciones"
    subTitle="A continuación encontrará los productos en los que nos especializamos. Contamos con una completa gama a precios competitivos enfocados a brindar soluciones logísticas en transporte y control de activos."
  />

  <section class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        soluciones.map(solucion => (
          <a
            href={`/productos/${solucion.id}`}
            class="group hover:border-brand-400 dark:hover:border-brand-400 flex flex-col rounded-xl border border-neutral-300 bg-neutral-100 p-6 ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 dark:border-neutral-700 dark:bg-neutral-900 dark:ring-zinc-200"
          >
            <Icon name={solucion.data.icon} />
            <h2 class="mt-4 font-bold text-neutral-800 dark:text-neutral-200">
              {solucion.data.title}
            </h2>
            <p class="mt-2 grow text-sm text-neutral-600 dark:text-neutral-400">
              {solucion.data.description}
            </p>
            <span class="text-brand-600 dark:text-brand-400 mt-4 inline-flex items-center gap-x-2 text-sm font-medium">
              Ver más
              <Icon name="arrowRight" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <HeroSectionAlt
    title="¿No sabe cuál necesita?"
    subTitle="Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa."
    url="/contacto"
    btnTitle="Solicitar asesoría"
  />
</MainLayout>
