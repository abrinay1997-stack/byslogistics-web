---
// Import necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import backdrop from '@images/backgrounds/logistica-claro.jpg';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import { SITE } from '@data/constants';
import { RESENA } from '@data/empresa';

/**
 * Página "Nosotros".
 *
 * TODO(imágenes): esta página aún no lleva fotografías porque las que trae la
 * plantilla son de construcción y no corresponden al negocio. Falta el material
 * fotográfico de la empresa (precintos en uso, contenedores, equipo de trabajo).
 */

const pageTitle: string = `Nosotros | ${SITE.title}`;
const metaDescription =
  'BUSINESS & SUPPLIES LOGISTICS S.A.S. es una empresa colombiana fundada en 2011 que se especializa en la distribución y comercialización de productos y elementos de seguridad preventiva.';
const ogTitle = `Nosotros | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${SITE.url}/nosotros`,
    url: `${SITE.url}/nosotros`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'es-CO',
  }}
>
  <MainSection
    title="B&S, Somos Líderes en Seguridad Preventiva"
    subTitle="Distribuimos y comercializamos los elementos de seguridad preventiva que intervienen en la cadena de custodia y logística de las compañías."
    btnExists={true}
    btnTitle="Solicitar una cotización"
    btnURL="/contacto"
    backdrop={backdrop}
    backdropTreatment="photo"
  />

  <section class="mx-auto max-w-[85rem] px-10 pb-16 sm:px-14 lg:px-20 lg:pb-24">
    <div class="grid max-w-prose gap-6">
      {
        RESENA.map(paragraph => (
          <p class="text-lg leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400">
            {paragraph}
          </p>
        ))
      }
    </div>
  </section>

  <HeroSectionAlt
    title="Estamos Aquí Para Ayudarle, Contáctenos Ahora"
    subTitle="Tenemos una gran variedad de elementos de seguridad. Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa."
    url="/contacto"
  />
</MainLayout>
