---
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import backdrop from '@images/backgrounds/precinto-tecnologia.jpg';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import { SITE } from '@data/constants';
import { SECTORES } from '@data/empresa';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '@components/ui/icons/Icon.astro';

/**
 * Índice de usos. Funciona como un hub: arriba las guías —que son las páginas
 * que traen visitas por búsqueda orgánica— y abajo los sectores, que resumen a
 * quién le vendemos.
 *
 * El orden no es casual. Quien llega buscando "precinto para carrotanque"
 * necesita la guía; la lista de sectores le sirve a quien ya nos conoce y
 * quiere saber si trabajamos con lo suyo.
 */
const guias = (await getCollection('usos')).sort(
  (a, b) => a.data.order - b.data.order
);

const pageTitle = `Usos | ${SITE.title}`;
const metaDescription =
  'Sectores donde aplicamos nuestros elementos de seguridad preventiva: financiero, transporte, combustibles e hidrocarburos, minería, alimentos, cárnicos, apuestas y farmacéuticos.';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/usos`,
    url: `${SITE.url}/usos`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'es-CO',
  }}
>
  <MainSection
    title="Usos y sectores que atendemos"
    subTitle="Nuestra gama de productos nos ha permitido suministrar a líderes de industria en sectores donde la trazabilidad y el control de activos no admiten dudas."
    backdrop={backdrop}
  />

  {/* Las guías, lo primero: son la puerta de entrada por búsqueda. */}
  <section class="mx-auto max-w-[85rem] px-10 pb-16 sm:px-14 lg:px-20">
    <h2
      class="text-2xl font-bold text-neutral-800 lg:text-3xl dark:text-neutral-100"
    >
      Guías por aplicación
    </h2>
    <p class="mt-3 max-w-prose text-neutral-600 dark:text-neutral-400">
      Qué producto corresponde a cada punto que necesita asegurar, cómo se
      instala y cómo se verifica al recibir.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        guias.map(guia => (
          <a
            href={`/usos/${guia.id}`}
            class="group hover:border-brand-400 dark:hover:border-brand-400 flex flex-col overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-100 ring-zinc-500 outline-hidden transition duration-300 hover:-translate-y-1 hover:shadow-xl focus-visible:ring-3 dark:border-neutral-700 dark:bg-neutral-900 dark:ring-zinc-200"
          >
            {guia.data.heroImage && (
              <div class="flex aspect-[5/3] items-center justify-center bg-white">
                <Image
                  src={guia.data.heroImage}
                  alt={guia.data.heroImageAlt ?? guia.data.title}
                  class="h-full w-full object-contain p-6 transition-transform duration-500 group-hover:scale-105"
                  widths={[320, 480]}
                  sizes="(min-width: 1024px) 24rem, 90vw"
                  loading="lazy"
                />
              </div>
            )}
            <div class="flex grow flex-col p-6">
              <p class="text-brand-700 dark:text-brand-400 text-xs font-bold tracking-wide uppercase">
                {guia.data.sector}
              </p>
              <h3 class="mt-2 text-lg font-bold text-balance text-neutral-800 dark:text-neutral-100">
                {guia.data.title}
              </h3>
              <p class="mt-2 grow text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                {guia.data.summary}
              </p>
              <span class="text-brand-600 dark:text-brand-400 mt-4 inline-flex items-center gap-x-2 text-sm font-bold">
                Leer la guía
                <span class="transition-transform duration-300 group-hover:translate-x-1">
                  <Icon name="arrowRight" />
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-10 pb-16 sm:px-14 lg:px-20 lg:pb-24">
    <h2
      class="mb-8 text-2xl font-bold text-neutral-800 lg:text-3xl dark:text-neutral-100"
    >
      Sectores que atendemos
    </h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        SECTORES.map(sector => (
          <div class="rounded-xl border border-neutral-300 bg-neutral-100 p-6 dark:border-neutral-700 dark:bg-neutral-900">
            <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
              {sector.name}
            </h3>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {sector.description}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <HeroSectionAlt
    title="¿Su sector no aparece en la lista?"
    subTitle="Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa."
    url="/contacto"
    btnTitle="Contáctenos"
  />
</MainLayout>
