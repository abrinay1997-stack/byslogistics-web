---
/**
 * Wordmark provisional de BYS Logistics.
 *
 * Reemplazar por el logo oficial cuando esté disponible: basta con sustituir el
 * contenido de este archivo manteniendo `{...Astro.props}` en el <svg> raíz,
 * para que las clases de tamaño que pasan Navbar y FooterSection sigan
 * aplicando. Ten en cuenta que este wordmark usa <text>, así que depende de las
 * fuentes del sistema; el logo definitivo debería traer los trazos en <path>.
 */
---

<svg
  {...Astro.props}
  viewBox="0 0 320 130"
  fill="none"
  role="img"
  aria-label="BYS Logistics"
>
  <title>BYS Logistics</title>
  {/* Marca: tres barras inclinadas que sugieren carga en movimiento */}
  <g
    transform="translate(28,0) skewX(-18)"
    class="fill-current text-brand-500 dark:text-brand-400"
  >
    <rect x="26" y="30" width="74" height="15" rx="7.5"></rect>
    <rect x="18" y="54" width="82" height="15" rx="7.5"></rect>
    <rect x="10" y="78" width="90" height="15" rx="7.5"></rect>
  </g>

  {/* Wordmark */}
  <text
    x="132"
    y="70"
    class="fill-current text-neutral-800 dark:text-neutral-200"
    font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    font-size="56"
    font-weight="800"
    letter-spacing="-1">BYS</text
  >
  <text
    x="134"
    y="105"
    class="fill-current text-neutral-600 dark:text-neutral-400"
    font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    font-size="24"
    font-weight="500"
    letter-spacing="3.4">LOGISTICS</text
  >
</svg>
