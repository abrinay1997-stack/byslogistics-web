---
/**
 * Logo oficial de B&S Logistics.
 *
 * El PNG original (1600x839, fondo transparente) vive en
 * `src/images/brand/logo.png`, así que Astro lo optimiza y genera las
 * versiones responsivas. Navbar y FooterSection controlan el tamaño con la
 * clase que le pasan (`w-24`, `w-32`).
 *
 * El logo solo existe en versión para fondo claro: sus letras son negras y
 * grises. En modo oscuro se dibuja sobre una base blanca para que siga siendo
 * legible. Si llega una versión para fondo oscuro, se puede importar aquí y
 * mostrarla con `hidden dark:block` en lugar de la base blanca.
 */
import { Image } from 'astro:assets';
import logo from '@images/brand/logo.png';

const { class: className, ...rest } = Astro.props;

interface Props {
  class?: string;
  [key: string]: unknown;
}
---

<span
  class:list={[
    'inline-block rounded-md dark:bg-white dark:px-1.5 dark:py-1',
    className,
  ]}
>
  <Image
    src={logo}
    alt="B&S Logistics"
    widths={[160, 320, 480]}
    sizes="(min-width: 768px) 160px, 128px"
    class="h-auto w-full"
    loading="eager"
    {...rest}
  />
</span>
