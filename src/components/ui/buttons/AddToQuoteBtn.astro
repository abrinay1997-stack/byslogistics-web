---
/**
 * Botón "Añadir" del cotizador. El estado (añadido o no) lo pinta
 * quoteCart.js leyendo el carrito, por eso el marcado es el mismo siempre.
 */
const { id, name, group } = Astro.props;

interface Props {
  id: string;
  name: string;
  group: string;
}
---

<button
  type="button"
  data-quote-add={id}
  data-quote-name={name}
  data-quote-group={group}
  data-added="false"
  class="bg-brand-600 hover:bg-brand-700 mt-4 inline-flex w-full items-center justify-center gap-x-2 rounded-full border border-transparent px-4 py-2.5 text-sm font-bold text-neutral-50 ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 data-[added=true]:bg-neutral-600 data-[added=true]:hover:bg-neutral-700 dark:ring-zinc-200"
>
  <span data-quote-add-label>Añadir</span>
  a cotización
</button>
