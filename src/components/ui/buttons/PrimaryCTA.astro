---
import Icon from '@components/ui/icons/Icon.astro';
// Destructure the properties from Astro.props
const { title, url, noArrow, size = 'md', tone = 'brand' } = Astro.props;
// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
  noArrow?: boolean;
  /** `lg` para los llamados principales (hero y cierres de página). */
  size?: 'md' | 'lg';
  /**
   * `onBrand` para cuando el botón va sobre el azul de la marca: el relleno
   * azul se perdería contra el fondo, así que se invierte a blanco sobre azul.
   */
  tone?: 'brand' | 'onBrand';
}
// Define CSS classes for styling the button
const baseClasses =
  'group inline-flex items-center justify-center gap-x-2 rounded-full font-bold ring-zinc-500 transition duration-300 focus-visible:ring-3 outline-hidden';
const sizeClasses =
  size === 'lg'
    ? 'px-8 py-4 text-base sm:text-lg'
    : 'px-6 py-3.5 text-sm 2xl:text-base';
const borderClasses = 'border border-transparent';
// Relieve y desplazamiento al pasar el cursor: el botón principal tiene que
// pesar más que el resto de la página, no confundirse con un enlace.
const bgColorClasses =
  tone === 'onBrand'
    ? 'bg-white text-brand-700 shadow-lg shadow-brand-950/25 hover:bg-brand-50 hover:shadow-xl hover:shadow-brand-950/30 hover:-translate-y-0.5 active:translate-y-0 active:bg-brand-100'
    : 'bg-brand-600 text-neutral-50 shadow-lg shadow-brand-600/25 hover:bg-brand-700 hover:shadow-xl hover:shadow-brand-700/30 hover:-translate-y-0.5 active:translate-y-0 active:bg-brand-700 dark:focus:outline-hidden';
const disableClasses = 'disabled:pointer-events-none disabled:opacity-50';
// Sobre azul el anillo de foco tiene que ser claro para verse; el zinc oscuro
// del tema normal se pierde contra el fondo.
const ringClasses = tone === 'onBrand' ? 'ring-white' : 'dark:ring-zinc-200';
---

{/* Link styled as a button, with dynamic title, URL, and optional arrow */}
<a
  class={`${baseClasses} ${sizeClasses} ${borderClasses} ${bgColorClasses} ${disableClasses} ${ringClasses}`}
  href={url}
>
  {title}
  {/* Display the arrow based on the 'noArrow' property */}

  {
    noArrow ? null : (
      <span class="transition-transform duration-300 group-hover:translate-x-1">
        <Icon name="arrowRight" />
      </span>
    )
  }
</a>
