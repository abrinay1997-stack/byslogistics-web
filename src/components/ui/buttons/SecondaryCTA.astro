---
// Destructure the properties from Astro.props
const { title, url, size = 'md' } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
  /** `lg` para emparejar con un PrimaryCTA grande. */
  size?: 'md' | 'lg';
}
// Botón secundario de contorno: al no llevar relleno sólido no compite con el
// principal, pero conserva su mismo tamaño y forma para que el par se lea como
// una sola unidad.
const baseClasses =
  'inline-flex items-center justify-center gap-x-2 rounded-full text-center font-bold outline-hidden ring-zinc-500 focus-visible:ring-3 transition duration-300';
const sizeClasses =
  size === 'lg'
    ? 'px-8 py-4 text-base sm:text-lg'
    : 'px-6 py-3.5 text-sm 2xl:text-base';
const colorClasses =
  'border-2 border-neutral-400 bg-transparent text-neutral-700 hover:border-brand-600 hover:text-brand-700 active:text-brand-800';
const disableClasses = 'disabled:pointer-events-none disabled:opacity-50';
const darkClasses =
  'dark:border-neutral-600 dark:text-neutral-200 dark:ring-zinc-200 dark:hover:border-brand-400 dark:hover:text-brand-300 dark:focus:outline-hidden';
---

{/* Styled hyperlink */}
<a
  class={`${baseClasses} ${sizeClasses} ${colorClasses} ${disableClasses} ${darkClasses}`}
  href={url}
>
  {title}
</a>
