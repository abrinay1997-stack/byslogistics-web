---
/**
 * Botón que abre el panel del cotizador con lo ya acumulado.
 *
 * Vivía flotando abajo a la derecha, junto al de WhatsApp. Subió a la barra
 * porque es donde se busca un carrito, y porque abajo competía por el mismo
 * rincón con el asistente y con WhatsApp: tres cosas flotando en la misma
 * esquina y ninguna se pulsa bien.
 *
 * Nace oculto y lo muestra `quoteCart.js` en cuanto hay una referencia
 * acumulada: un botón de cotización con la cotización vacía no lleva a
 * ninguna parte.
 *
 * Va como icono con contador y no como botón con etiqueta: al lado tiene el
 * CTA «Cotizar» (QuoteCta.astro), y dos píldoras sólidas seguidas se leen como
 * el mismo botón repetido. El contador es lo que hay que ver de un vistazo.
 *
 * Se renderiza dos veces —una en la fila del logo para el móvil, otra en la de
 * los enlaces para el escritorio—, y por eso no lleva `id`. El script escucha
 * por `[data-quote-toggle]` en plural, así que los dos abren el mismo panel.
 */
interface Props {
  /** Clases del contenedor, para colocarlo en cada fila de la barra. */
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-quote-toggle
  hidden
  title="Ver mi cotización"
  aria-label="Ver mi cotización"
  class:list={[
    'border-brand-200 text-brand-700 hover:border-brand-400 hover:bg-brand-50 dark:text-brand-300 relative inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border bg-white/70 ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 dark:border-white/20 dark:bg-white/10 dark:hover:bg-white/20',
    className,
  ]}
>
  <svg
    class="h-5 w-5 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {/* Hoja de cotización: documento con renglones y su esquina doblada. */}
    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"
    ></path>
    <path d="M14 3v5h5"></path>
    <path d="M9 13h6"></path>
    <path d="M9 17h4"></path>
  </svg>
  <span
    class="bg-brand-600 absolute -top-1 -right-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full px-1.5 text-xs font-bold text-white tabular-nums"
    data-quote-count>0</span
  >
</button>
