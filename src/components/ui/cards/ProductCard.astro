---
import { Image } from 'astro:assets';
import Icon from '@components/ui/icons/Icon.astro';
import ImagePlaceholder from '@components/ui/blocks/ImagePlaceholder.astro';

/**
 * Tarjeta de familia o categoría de producto. La usan la home, /productos y
 * /precintos, que antes repetían el mismo bloque con variantes menores.
 *
 * Las fotos del catálogo vienen recortadas sobre fondo blanco, así que la
 * imagen va en `object-contain` sobre un panel propio: recortarlas a `cover`
 * les cortaría el cuerpo del precinto.
 */
interface Props {
  href: string;
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Línea suelta bajo la descripción, p. ej. "8 referencias". */
  meta?: string;
  cta?: string;
  /** `h2` en las páginas de listado, `h3` cuando la sección ya trae un h2. */
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  title,
  description,
  image,
  imageAlt,
  meta,
  cta = 'Ver más',
  headingLevel: Heading = 'h2',
} = Astro.props;
---

<a
  href={href}
  class="group hover:border-brand-400 dark:hover:border-brand-400 flex flex-col overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-100 ring-zinc-500 outline-hidden transition duration-300 hover:-translate-y-1 hover:shadow-xl focus-visible:ring-3 dark:border-neutral-700 dark:bg-neutral-900 dark:ring-zinc-200"
>
  <div
    class="flex aspect-[5/3] items-center justify-center overflow-hidden bg-white"
  >
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? title}
          class="h-full w-full object-contain p-6 transition-transform duration-500 group-hover:scale-105"
          widths={[320, 480]}
          sizes="(min-width: 1024px) 24rem, (min-width: 640px) 45vw, 90vw"
          loading="lazy"
          draggable={false}
        />
      ) : (
        <ImagePlaceholder />
      )
    }
  </div>

  <div class="flex grow flex-col p-6 sm:p-7">
    <Heading class="text-lg font-bold text-neutral-800 dark:text-neutral-100">
      {title}
    </Heading>
    <p
      class="mt-2 grow text-sm leading-relaxed text-neutral-600 dark:text-neutral-400"
    >
      {description}
    </p>
    {
      meta && (
        <p class="mt-3 text-xs text-neutral-600 dark:text-neutral-400">
          {meta}
        </p>
      )
    }
    <span
      class="text-brand-600 dark:text-brand-400 mt-5 inline-flex items-center gap-x-2 text-sm font-bold"
    >
      {cta}
      <span class="transition-transform duration-300 group-hover:translate-x-1"
        ><Icon name="arrowRight" /></span
      >
    </span>
  </div>
</a>
