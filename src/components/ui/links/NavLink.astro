---
// Destructure the properties from Astro.props
const { url, name } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  url: string;
  name: string;
}
---

{
  /*
Enlace reutilizable de la barra de navegación. El destino viaja en un
`data-nav-url` en lugar de en un `id` derivado de la ruta: el marcado ya trae
el href, y así el script no tiene que reconstruir identificadores.
*/
}
<a
  data-nav-url={url}
  href={url}
  data-astro-prefetch
  class="nav-link rounded-lg text-base font-medium text-neutral-600 ring-zinc-500 outline-hidden hover:text-neutral-800 focus-visible:ring-3 lg:py-3 lg:text-sm xl:text-base dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-200 dark:focus:outline-hidden"
>
  {name}
</a>

<style>
  /* El destacado va por CSS y no quitando clases desde el script: la lista de
     clases que había que retirar se desincronizaba con la del marcado, y
     `classList.remove` reventaba en cuanto una de ellas traía un espacio. */
  .nav-link[aria-current='page'] {
    color: var(--color-brand-600);
    font-weight: 700;
  }

  :global(.dark) .nav-link[aria-current='page'] {
    color: var(--color-brand-300);
  }
</style>

<script>
  function marcarEnlaceActivo() {
    const ruta = window.location.pathname.replace(/\/+$/, '') || '/';

    for (const enlace of document.querySelectorAll<HTMLAnchorElement>(
      '[data-nav-url]'
    )) {
      const destino = enlace.dataset.navUrl ?? '';
      // Una subpágina destaca su sección: /precintos/de-guaya marca «Precintos».
      // La portada es la excepción, porque si no sería prefijo de todo.
      const activo =
        destino === '/'
          ? ruta === '/'
          : ruta === destino || ruta.startsWith(`${destino}/`);

      if (activo) enlace.setAttribute('aria-current', 'page');
      else enlace.removeAttribute('aria-current');
    }
  }

  marcarEnlaceActivo();
  document.addEventListener('astro:page-load', marcarEnlaceActivo);
</script>
