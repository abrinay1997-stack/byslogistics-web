---
import { Image } from 'astro:assets';

/**
 * Fondo lateral de sección.
 *
 * La imagen ocupa el lado contrario al del contenido y se desvanece con una
 * máscara hacia el lado donde está el texto, que así conserva su fondo limpio.
 *
 * Dos tratamientos, los dos con la imagen nítida:
 *
 * - `mate` (el de por defecto): la imagen va desaturada y con un velo del
 *   color de la sección encima. Se sigue viendo con todo su detalle, pero
 *   apagada, de modo que se asienta como fondo en lugar de competir con el
 *   texto. Sin desenfoque: emborronarla se veía peor que la foto original.
 * - `photo`: la imagen va tal cual. Reservado para ilustraciones y planos
 *   generales, que ya de por sí no distraen.
 *
 * La sección que lo use debe ser `relative overflow-hidden`, y su contenido ir
 * en un contenedor `relative` para quedar por encima.
 *
 * Por debajo de `lg` el texto ocupa todo el ancho, así que el fondo se oculta:
 * cualquier imagen detrás del texto estorbaría la lectura.
 */
interface Props {
  src: ImageMetadata;
  /** Lado en el que se ve la imagen. El texto va en el contrario. */
  side?: 'left' | 'right';
  /** Ancho de la franja, en porcentaje del ancho de la sección. */
  width?: string;
  treatment?: 'mate' | 'photo';
}

const { src, side = 'right', width = '56%', treatment = 'mate' } = Astro.props;
---

<div
  class:list={[
    'backdrop',
    side === 'right' ? 'to-right' : 'to-left',
    treatment === 'mate' && 'mate',
  ]}
  style={`--backdrop-width:${width}`}
  aria-hidden="true"
>
  <Image
    src={src}
    alt=""
    class="h-full w-full object-cover"
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 56vw, 0px"
    loading="lazy"
    decoding="async"
    draggable={false}
  />
  {treatment === 'mate' && <div class="veil" />}
</div>

<style>
  .backdrop {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--backdrop-width);
    pointer-events: none;
    user-select: none;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .backdrop {
      display: block;
    }
  }

  .to-right {
    right: 0;
  }

  .to-left {
    left: 0;
  }

  /* Bajar la saturación es lo que apaga la imagen: el motivo se sigue viendo
     con todo su detalle, pero deja de gritar al lado del texto. */
  .mate :global(img) {
    filter: saturate(0.32) contrast(0.92);
  }

  /* Velo del color de la sección: es lo que asienta la imagen como fondo en
     lugar de dejarla flotando encima. */
  .veil {
    position: absolute;
    inset: 0;
    background: rgb(229 229 229 / 0.45);
  }

  :global(.dark) .veil {
    background: rgb(38 38 38 / 0.5);
  }

  /* Dos degradados combinados: el horizontal apaga la imagen del lado del
     texto, el vertical le quita el corte seco contra la sección vecina. Van en
     el contenedor, para que la máscara cubra imagen y velo de una sola vez. */
  @media (min-width: 1024px) {
    .to-right {
      mask-image:
        linear-gradient(
          to right,
          transparent 0%,
          rgba(0, 0, 0, 0.25) 26%,
          rgba(0, 0, 0, 0.85) 48%,
          #000 62%
        ),
        linear-gradient(
          to bottom,
          transparent 0%,
          #000 14%,
          #000 86%,
          transparent 100%
        );
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
    }

    .to-left {
      mask-image:
        linear-gradient(
          to left,
          transparent 0%,
          rgba(0, 0, 0, 0.25) 26%,
          rgba(0, 0, 0, 0.85) 48%,
          #000 62%
        ),
        linear-gradient(
          to bottom,
          transparent 0%,
          #000 14%,
          #000 86%,
          transparent 100%
        );
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
    }
  }
</style>
