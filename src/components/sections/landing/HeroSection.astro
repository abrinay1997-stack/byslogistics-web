---
// Import the necessary dependencies
import { Image } from 'astro:assets';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import SectionBackdrop from '@components/ui/blocks/SectionBackdrop.astro';

// Define props from Astro
const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  src,
  alt,
} = Astro.props;

// Define TypeScript interface for props
interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  /** Imagen del hero: fondo lateral en escritorio, imagen suelta en móvil. */
  src?: ImageMetadata;
  alt?: string;
}
---

{
  /* Sección a sangre: la imagen del fondo llega hasta el borde de la pantalla */
}
<section class="relative overflow-hidden">
  {src && <SectionBackdrop src={src} side="right" width="58%" />}

  <div
    class="relative mx-auto max-w-[85rem] px-6 py-20 sm:px-8 lg:px-12 lg:py-32"
  >
    <div class="lg:grid lg:grid-cols-12 lg:items-center lg:gap-12">
      {/* Title and description */}
      <div class="lg:col-span-6 xl:col-span-5">
        {
          /* Each h1 and p tag renders a portion of the title and subTitle defined above */
        }
        <h1
          class="block text-4xl font-bold tracking-tight text-balance text-neutral-800 sm:text-5xl lg:text-6xl lg:leading-[1.08] xl:text-7xl dark:text-neutral-100"
        >
          {
            /* About Fragment: https://docs.astro.build/en/basics/astro-syntax/#fragments */
          }
          <Fragment set:html={title} />
        </h1>
        {
          subTitle && (
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-neutral-700 lg:text-xl dark:text-neutral-300">
              {subTitle}
            </p>
          )
        }
        {
          /* Action Button Section: This section includes two CTAs with their own styles and URL */
        }
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          {
            primaryBtn && (
              <PrimaryCTA title={primaryBtn} url={primaryBtnURL} size="lg" />
            )
          }
          {
            secondaryBtn && (
              <SecondaryCTA
                title={secondaryBtn}
                url={secondaryBtnURL}
                size="lg"
              />
            )
          }
        </div>
      </div>

      {
        /* En móvil el fondo lateral no se muestra, así que la imagen va aquí,
           debajo del texto y a la vista. */
      }
      {
        src && alt && (
          <div class="mt-12 lg:hidden">
            <Image
              src={src}
              alt={alt}
              class="aspect-[16/10] w-full rounded-2xl object-cover"
              draggable={false}
              loading="eager"
              fetchpriority="high"
              widths={[480, 768]}
              sizes="100vw"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
