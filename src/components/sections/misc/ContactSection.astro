---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { CONTACT, FORMS } from '@data/constants';

const copy = {
  title: 'Estamos aquí para ayudarle',
  subTitle:
    'Tenemos una gran variedad de elementos de seguridad. Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa.',
  formTitle: 'Realizar una consulta',
  formSubTitle: 'Le respondemos en un plazo de 1 a 2 días hábiles.',
  name: 'Nombre',
  details: 'Mensaje adicional',
  send: 'Enviar mensaje',
  pbxHeading: 'P.B.X. en Bogotá',
  pbxContent: 'Comuníquese con nuestras líneas fijas.',
  mobileHeading: 'Celulares',
  mobileContent: 'También puede escribirnos por WhatsApp.',
  panamaHeading: 'Celular Panamá',
  panamaContent: 'Atención para operaciones en Panamá.',
  emailHeading: 'Escríbanos por correo',
  emailContent: '¿Prefiere el correo electrónico? Escríbanos a',
  mapHeading: 'Dónde estamos',
  mapContent: 'Estamos en Bogotá, Colombia. ',
};
---

<section class="mx-auto max-w-[85rem] px-10 py-16 sm:px-14 lg:px-20 lg:py-24">
  <div>
    {
      /* Alineado a la izquierda y con la misma escala de encabezado que el
         resto del sitio (ver MainSection.astro). Centrado y en un cuerpo
         menor, esta era la única página que rompía el eje de lectura. */
    }
    <div class="max-w-2xl">
      <h1
        class="mb-5 text-4xl font-extrabold tracking-tight text-balance text-neutral-800 sm:text-5xl lg:text-6xl dark:text-neutral-100"
      >
        {copy.title}
      </h1>
      <p
        class="max-w-prose text-lg font-normal text-pretty text-neutral-600 sm:text-xl dark:text-neutral-400"
      >
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-start gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2
          class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300"
        >
          {copy.formTitle}
        </h2>
        <form
          name={FORMS.contact}
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="botcheck"
          data-contact-form
          data-form-whatsapp={CONTACT.whatsapp}
          data-wa-intro="Hola, quisiera hacer una consulta:"
          data-form-success="¡Gracias! Recibimos su mensaje y le respondemos en 1 o 2 días hábiles."
        >
          {/* Netlify identifica el formulario por este campo */}
          <input type="hidden" name="form-name" value={FORMS.contact} />

          <div class="grid gap-4">
            <TextInput id="hs-name-contacts" label={copy.name} name="name" />
            <EmailContactInput id="hs-email-contacts" />
            <PhoneInput id="hs-phone-number" />
            <TextAreaInput
              id="hs-about-contacts"
              label={copy.details}
              name="message"
            />
          </div>

          {
            /* Trampa antispam: oculta para las personas, visible para los robots */
          }
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          {/* Autorización de tratamiento de datos (Ley 1581 de 2012) */}
          <label class="mt-4 flex items-start gap-x-3 text-sm">
            <input
              type="checkbox"
              name="autorizacion"
              value="Sí"
              required
              class="text-brand-600 focus:ring-brand-500 mt-1 shrink-0 rounded-sm border-neutral-300 dark:border-neutral-600"
            />
            {
              /* El `{' '}` no es decorativo: sin él Astro se come el salto de
                 línea que separa el texto del enlace y queda pegado («conforme
                 a laPolítica…»). Mismo idioma que usa el footer. */
            }
            <span class="text-neutral-600 dark:text-neutral-400">
              Autorizo el tratamiento de mis datos personales conforme a la{' '}
              <a
                href="/politica-de-datos"
                class="text-brand-700 dark:text-brand-400 underline underline-offset-2"
                >Política de Tratamiento de Datos Personales</a
              >.
            </span>
          </label>

          <div class="mt-4 grid">
            <AuthBtn title={copy.send} />
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {copy.formSubTitle}
            </p>
            <p
              class="mt-2 text-sm data-[kind=error]:text-red-600 data-[kind=ok]:text-green-700 dark:data-[kind=error]:text-red-400 dark:data-[kind=ok]:text-green-400"
              data-form-status
              hidden
              aria-live="polite"
            >
            </p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.pbxHeading}
          content={copy.pbxContent}
          links={CONTACT.pbx}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.mobileHeading}
          content={copy.mobileContent}
          links={CONTACT.mobiles}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.panamaHeading}
          content={copy.panamaContent}
          links={[CONTACT.panama]}
          ><Icon name="earth" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle={CONTACT.email}
          linkURL={`mailto:${CONTACT.email}`}
          ><Icon name="envelopeOpen" />
        </ContactIconBlock>
      </div>
    </div>

    {/* Mapa de la sede. loading="lazy" para no penalizar la carga inicial. */}
    <div class="mt-12">
      <h2 class="text-xl font-bold text-neutral-700 dark:text-neutral-300">
        {copy.mapHeading}
      </h2>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
        {copy.mapContent}
        <a
          href={CONTACT.mapLink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-700 dark:text-brand-400 underline underline-offset-2"
          >Abrir en Google Maps</a
        >.
      </p>
      <div
        class="mt-4 overflow-hidden rounded-xl border border-neutral-300 dark:border-neutral-700"
      >
        <iframe
          src={CONTACT.mapEmbed}
          title="Ubicación de B&S Logistics en Google Maps"
          width="100%"
          height="420"
          style="border:0"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class="block w-full"></iframe>
      </div>
    </div>
  </div>
</section>
