---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { CONTACT } from '@data/constants';

const copy = {
  title: 'Estamos aquí para ayudarte',
  subTitle:
    'Tenemos una gran variedad de elementos de seguridad. Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa.',
  formTitle: 'Realizar una consulta',
  formSubTitle: 'Te respondemos en un plazo de 1 a 2 días hábiles.',
  name: 'Nombre',
  details: 'Mensaje adicional',
  send: 'Enviar mensaje',
  demoMessage:
    '¡Gracias! (Demo — conecta un endpoint de formulario para recibir mensajes reales.)',
  pbxHeading: 'P.B.X. en Bogotá',
  pbxContent: 'Comunícate con nuestras líneas fijas.',
  mobileHeading: 'Celulares',
  mobileContent: 'También puedes escribirnos por WhatsApp.',
  panamaHeading: 'Celular Panamá',
  panamaContent: 'Atención para operaciones en Panamá.',
  emailHeading: 'Escríbenos por correo',
  emailContent: '¿Prefieres el correo electrónico? Escríbenos a',
};
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-start gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2
          class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300"
        >
          {copy.formTitle}
        </h2>
        <form data-demo-form data-demo-message={copy.demoMessage}>
          <div class="grid gap-4">
            <TextInput
              id="hs-name-contacts"
              label={copy.name}
              name="hs-name-contacts"
            />
            <EmailContactInput id="hs-email-contacts" />
            <PhoneInput id="hs-phone-number" />
            <TextAreaInput
              id="hs-about-contacts"
              label={copy.details}
              name="hs-about-contacts"
            />
          </div>

          <div class="mt-4 grid">
            <AuthBtn title={copy.send} />
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {copy.formSubTitle}
            </p>
            <p
              class="mt-2 hidden text-sm text-brand-500 dark:text-brand-400"
              data-demo-status
              aria-live="polite"
            >
            </p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.pbxHeading}
          content={copy.pbxContent}
          links={CONTACT.pbx}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.mobileHeading}
          content={copy.mobileContent}
          links={CONTACT.mobiles}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.panamaHeading}
          content={copy.panamaContent}
          links={[CONTACT.panama]}
          ><Icon name="earth" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle={CONTACT.email}
          linkURL={`mailto:${CONTACT.email}`}
          ><Icon name="envelopeOpen" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
