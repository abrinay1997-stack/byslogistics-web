---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { CONTACT, SITE } from '@data/constants';

const copy = {
  title: 'Contáctanos',
  subTitle:
    '¿Tienes una operación en mente o necesitas una cotización? Escríbenos y diseñamos la solución logística que mejor se ajuste a tu carga.',
  formTitle: 'Completa el formulario',
  formSubTitle: 'Te respondemos en un plazo de 1 a 2 días hábiles.',
  firstName: 'Nombre',
  lastName: 'Apellido',
  details: 'Cuéntanos sobre tu operación',
  send: 'Enviar mensaje',
  demoMessage:
    '¡Gracias! (Demo — conecta un endpoint de formulario para recibir mensajes reales.)',
  phoneHeading: 'Llámanos',
  phoneContent: `Atención ${CONTACT.hours.toLowerCase()}.`,
  faqHeading: 'Preguntas frecuentes',
  faqContent: 'Encuentra respuestas rápidas a las consultas más comunes.',
  faqLink: 'Ver preguntas frecuentes',
  officeHeading: 'Visita nuestra oficina',
  officeContent: SITE.legalName,
  emailHeading: 'Escríbenos por correo',
  emailContent: '¿Prefieres el correo electrónico? Escríbenos a',
};

const addressContent = `${CONTACT.address.street}, ${CONTACT.address.city}, ${CONTACT.address.country}`;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2
          class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300"
        >
          {copy.formTitle}
        </h2>
        <form data-demo-form data-demo-message={copy.demoMessage}>
          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput
                id="hs-firstname-contacts"
                label={copy.firstName}
                name="hs-firstname-contacts"
              />
              <TextInput
                id="hs-lastname-contacts"
                label={copy.lastName}
                name="hs-lastname-contacts"
              />
            </div>
            <EmailContactInput id="hs-email-contacts" />
            <PhoneInput id="hs-phone-number" />
            <TextAreaInput
              id="hs-about-contacts"
              label={copy.details}
              name="hs-about-contacts"
            />
          </div>

          <div class="mt-4 grid">
            <AuthBtn title={copy.send} />
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {copy.formSubTitle}
            </p>
            <p
              class="mt-2 hidden text-sm text-orange-500 dark:text-orange-400"
              data-demo-status
              aria-live="polite"
            >
            </p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.phoneHeading}
          content={copy.phoneContent}
          isLinkVisible={true}
          linkTitle={CONTACT.phone}
          linkURL={CONTACT.phoneHref}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.faqHeading}
          content={copy.faqContent}
          isLinkVisible={true}
          linkTitle={copy.faqLink}
          linkURL="/#faq"
          isArrowVisible={true}
          ><Icon name="question" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeContent}
          isAddressVisible={true}
          addressContent={addressContent}
          ><Icon name="mapPin" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle={CONTACT.email}
          linkURL={`mailto:${CONTACT.email}`}
          ><Icon name="envelopeOpen" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
